# Required for all LLM-powered extraction, comparison, and decision features.
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Stable default model. Override this without changing code if needed.
GEMINI_MODEL=gemini-2.5-flash

# Paths may be absolute or relative to the repository root.
LOCAL_STORAGE_PATH=data/documents
SQLITE_DATABASE_PATH=data/loan_verification.db

# Local server configuration.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
LOG_LEVEL=INFO

# Optional when the executables are not available on PATH.
TESSERACT_CMD=
POPPLER_PATH=

# Frontend API URL (read by Vite at frontend build/start time).
VITE_API_BASE_URL=http://localhost:8000
